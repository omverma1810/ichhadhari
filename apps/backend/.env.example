# ==============================================================================
# Environment Variables Example
# ==============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit the actual .env file to version control!

# ==============================================================================
# GENERAL SETTINGS
# ==============================================================================

# Environment (development, production, test)
ENVIRONMENT=development

# Django Secret Key (Generate a new one for production!)
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-key-in-production-use-at-least-50-characters

# Debug mode (NEVER set to True in production!)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL Database
DB_NAME=ichhadhari_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

# Redis URL for cache and Celery
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================

# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================

# Email backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings (for production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password
# DEFAULT_FROM_EMAIL=noreply@ichhadhari.com
# SERVER_EMAIL=admin@ichhadhari.com

# ==============================================================================
# AWS S3 CONFIGURATION (Optional - for production file storage)
# ==============================================================================

# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# ==============================================================================
# SENTRY CONFIGURATION (Optional - for error tracking)
# ==============================================================================

# SENTRY_DSN=your-sentry-dsn-here

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================

# JWT token lifetimes (in seconds)
JWT_ACCESS_TOKEN_LIFETIME=43200  # 12 hours
JWT_REFRESH_TOKEN_LIFETIME=604800  # 7 days

# ==============================================================================
# CELERY CONFIGURATION
# ==============================================================================

# Celery broker URL (same as REDIS_URL typically)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================================================
# APPLICATION SPECIFIC
# ==============================================================================

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Admin URL (change in production for security)
ADMIN_URL=admin/

# ==============================================================================
# SECURITY SETTINGS (Production only)
# ==============================================================================

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Generate a strong SECRET_KEY for production
# 2. Never set DEBUG=True in production
# 3. Configure proper ALLOWED_HOSTS for production
# 4. Use strong database passwords
# 5. Set up proper email configuration for production
# 6. Enable HTTPS and security headers in production
# 7. Use environment-specific Redis instances
# 8. Configure Sentry for error tracking in production
